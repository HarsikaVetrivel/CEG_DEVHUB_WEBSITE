PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ceg-dev-hub

# SESSION_SECRET is REQUIRED in all environments.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the output below — do NOT use any placeholder value.
SESSION_SECRET=

CORS_ORIGIN=http://localhost:5173

# Frontend URL — used to build password-reset links in emails.
APP_URL=http://localhost:5173

# Brevo transactional email API (https://app.brevo.com → SMTP & API → API Keys)
BREVO_API_KEY=

# Sender address verified in Brevo (Senders & IPs → Senders)
EMAIL_FROM=noreply@yourdomain.com

# ── Google Sheet sync (optional) ─────────────────────────────────────────────
# Leave blank to disable the sheet sync job.

# The ID from the sheet URL: docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Full service-account key JSON (from Google Cloud Console → IAM → Service Accounts → Keys).
# Paste the entire JSON contents on one line, or use a file reference.
# IMPORTANT: share the Google Sheet with the service-account email
#            (found in the JSON as "client_email").
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# How often to poll the sheet in milliseconds (default: 300000 = 5 minutes)
SHEET_SYNC_INTERVAL_MS=300000

# ── Admin seed (only needed when running npm run seed:admin) ─────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ceg-dev-hub

# SESSION_SECRET is REQUIRED in all environments.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the output below — do NOT use any placeholder value.
SESSION_SECRET=

CORS_ORIGIN=http://localhost:5173

# Frontend URL — used to build password-reset links in emails.
APP_URL=http://localhost:5173

# Brevo transactional email API (https://app.brevo.com → SMTP & API → API Keys)
BREVO_API_KEY=

# Sender address verified in Brevo (Senders & IPs → Senders)
EMAIL_FROM=noreply@yourdomain.com

# Set these only when running `npm run seed:admin`.
# Use a unique account name and a strong password; never use shared defaults.
ADMIN_EMAIL=
ADMIN_PASSWORD=
